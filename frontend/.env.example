# Stellar testnet deployment configuration. Contract IDs are public addresses.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Populate these after running ../scripts/deploy.sh, then run ../scripts/initialize.sh.
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_CONTRACT_ID=
NEXT_PUBLIC_REVENUE_ROUTER_CONTRACT_ID=
NEXT_PUBLIC_VAULT_TOKEN_CONTRACT_ID=
NEXT_PUBLIC_ADMIN_ADDRESS=
